# Copy to .env and edit. Never commit .env.
NODE_ENV=production
PORT=3000
ADMIN_PASSWORD=change-me-to-a-long-random-password
ADMIN_KEY=change-me-registration-access-key
SESSION_HOURS=12
# REAL-DATA MODE: 0 = start empty, no synthetic records, no simulator (use this with real data).
# 1 = load the synthetic demo CSVs from seed/ and run the live-event simulator (demos only).
SEED_DEMO=0
SIMULATE=0
# Timezone of your bank. Off-hours detection uses the server clock.
TZ=Asia/Kolkata
# Optional: send high-risk alerts to Slack / Teams / Discord (incoming webhook URL).
ALERT_WEBHOOK_URL=
# Set when running behind a reverse proxy (Caddy, nginx, Render, Fly):
TRUST_PROXY=1
HTTPS_ONLY=1
# Optional Neon PostgreSQL connection string; set it to use Neon instead of local SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Used by the Caddy service in docker-compose (profile "https"):
DOMAIN=sentinel.example.com
